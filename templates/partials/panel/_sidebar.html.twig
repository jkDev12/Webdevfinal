{% set route = app.request.attributes.get('_route')|default('') %}
<aside class="panel-sidebar">
    <h1 class="panel-title">{{ is_granted('ROLE_ADMIN') ? 'Admin Panel' : (is_granted('ROLE_STAFF') ? 'Staff Panel' : 'My Account') }}</h1>

    <div class="panel-whoami">
        <span>{{ app.user.userIdentifier }}</span>
        <span class="role-badge {{ app.user.role }}">{{ app.user.role }}</span>
    </div>

    <nav class="panel-menu" aria-label="Main menu">
        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_admin_dashboard') }}" class="{{ route == 'app_admin_dashboard' ? 'active' : '' }}">Dashboard</a>
            <a href="{{ path('app_admin_user_index') }}" class="{{ route starts with 'app_admin_user' ? 'active' : '' }}">Users</a>
        {% endif %}
        {% if is_granted('ROLE_STAFF') %}
            <a href="{{ path('app_product_index') }}" class="{{ route starts with 'app_product' ? 'active' : '' }}">Products</a>
            <a href="{{ path('app_staff_stock') }}" class="{{ route starts with 'app_staff_stock' ? 'active' : '' }}">Update Stock</a>
            <a href="{{ path('app_log_index') }}" class="{{ route starts with 'app_log' ? 'active' : '' }}">Activity Logs</a>
        {% endif %}
        <a href="{{ path('app_account') }}" class="{{ route starts with 'app_account' ? 'active' : '' }}">Profile</a>
        <a href="{{ path('app_storefront') }}">Storefront</a>
        <a href="{{ path('app_logout') }}" class="panel-logout">Log Out</a>
    </nav>
</aside>
