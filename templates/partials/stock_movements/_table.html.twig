<div class="table-scroll">
<table class="admin-table responsive-table">
    <thead>
        <tr>
            <th>When</th><th>Product</th><th>Size</th><th>Action</th><th>Qty</th><th>Stock</th><th>By</th><th>Source</th><th>Note</th><th>Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for m in movements %}
            <tr>
                <td data-label="When">{{ m.createdAt|date('Y-m-d H:i:s') }}</td>
                <td data-label="Product">{{ m.productName }}{% if not m.product %} <span class="panel-hint">(deleted)</span>{% endif %}</td>
                <td data-label="Size">{{ m.size }}</td>
                <td data-label="Action">
                    <span class="status-badge {{ m.add ? 'active' : 'cancelled' }}">{{ m.add ? 'Posted' : 'Removed' }}</span>
                </td>
                <td data-label="Qty">{{ m.add ? '+' : '−' }}{{ m.quantity }}</td>
                <td data-label="Stock">{{ m.quantityBefore }} → {{ m.quantityAfter }}</td>
                <td data-label="By">{{ m.actorName }} <span class="role-badge {{ m.actorRole }}">{{ m.actorRole }}</span></td>
                <td data-label="Source">{{ m.sourceLabel }}</td>
                <td data-label="Note">{{ m.note ?? '—' }}</td>
                <td data-label="Actions" class="panel-actions">
                    {% if is_granted('LOG_EDIT', m) %}
                        <a class="mark-paid-btn panel-action-link" href="{{ path('app_log_edit', {id: m.id}) }}">Edit</a>
                    {% endif %}
                    {% if is_granted('LOG_DELETE', m) %}
                        <form method="post" class="cancel-order-form" action="{{ path('app_log_delete', {id: m.id}) }}"
                              onsubmit="return confirm('Delete log entry #{{ m.id }}? This cannot be undone. Stock levels are not changed.');">
                            <input type="hidden" name="csrf_token" value="{{ csrf_token('delete_log_' ~ m.id) }}">
                            <button type="submit" class="cancel-order-btn">Delete</button>
                        </form>
                    {% endif %}
                    {% if not is_granted('LOG_EDIT', m) and not is_granted('LOG_DELETE', m) %}<span class="panel-hint">View only</span>{% endif %}
                </td>
            </tr>
        {% else %}
            <tr><td colspan="10">No stock records match.</td></tr>
        {% endfor %}
    </tbody>
</table>
</div>
<p class="panel-count">{{ movements|length }} record(s) shown{% if movements|length >= 200 %} (latest 200 — narrow the filters to see older ones){% endif %}</p>
