{% extends 'panel/base.html.twig' %}

{% block title %}Change Password — John Kharl Caburog Apparel{% endblock %}

{% block content %}
    <h2 class="admin-section-title">Change Password</h2>

    {% include 'partials/form/_global_errors.html.twig' with {form: form} %}

    {{ form_start(form, {attr: {class: 'stock-form panel-form', novalidate: 'novalidate'}}) }}
        {% include 'partials/form/_field.html.twig' with {field: form.currentPassword} %}
        {% include 'partials/form/_field.html.twig' with {field: form.newPassword} %}
        {% include 'partials/form/_field.html.twig' with {field: form.confirmPassword} %}

        <div class="panel-actions">
            <button type="submit" class="stock-form-submit">Update password</button>
            <a class="panel-link" href="{{ path('app_account') }}">Cancel</a>
        </div>
    {{ form_end(form) }}
{% endblock %}
