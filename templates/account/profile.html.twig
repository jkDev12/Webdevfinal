{% extends 'panel/base.html.twig' %}

{% block title %}My Profile — John Kharl Caburog Apparel{% endblock %}

{% block content %}
    <h2 class="admin-section-title">My Profile</h2>

    <dl class="profile-list">
        <dt>Name / username</dt><dd>{{ user.username }}</dd>
        <dt>Email</dt><dd>{{ user.email }}</dd>
        <dt>Role</dt><dd><span class="role-badge {{ user.role }}">{{ user.role }}</span></dd>
        <dt>Status</dt><dd><span class="status-badge {{ user.active ? 'active' : 'cancelled' }}">{{ user.active ? 'Active' : 'Disabled' }}</span></dd>
        <dt>Member since</dt><dd>{{ user.createdAt|date('F j, Y') }}</dd>
    </dl>

    <div class="panel-actions">
        <a class="panel-btn" href="{{ path('app_account_password') }}">Change password</a>
    </div>
{% endblock %}
